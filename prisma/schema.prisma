generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  phone        String?
  role         String    @default("CUSTOMER") // CUSTOMER | STAFF | ADMIN
  createdAt    DateTime  @default(now())
  bookings     Booking[]

  // Cleaner-specific fields — only meaningful when role is STAFF (or ADMIN, unused there)
  payTrack         String? // OWN_SUPPLIES | COMPANY_SUPPLIES
  employmentStatus String? @default("ACTIVE") // ACTIVE | WARNED | TERMINATED

  bookingsAsCleaner  Booking[]        @relation("AssignedCleaner")
  bookingsPreferred  Booking[]        @relation("PreferredCleaner")
  reviewsReceived    Review[]
  disciplineReceived DisciplineNote[] @relation("DisciplineSubject")
  disciplineIssued   DisciplineNote[] @relation("DisciplineIssuer")
}

model Booking {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  name       String
  phone      String
  email      String
  homeSize   String
  service    String
  area       String
  addons     String?
  notes      String?
  totalPrice Int?
  status     String   @default("PENDING") // PENDING | CONFIRMED | COMPLETED | CANCELLED
  createdAt  DateTime @default(now())

  assignedCleanerId  String?
  assignedCleaner    User?    @relation("AssignedCleaner", fields: [assignedCleanerId], references: [id])
  preferredCleanerId String?
  preferredCleaner   User?    @relation("PreferredCleaner", fields: [preferredCleanerId], references: [id])
  review             Review?
}

model Applicant {
  id         String   @id @default(cuid())
  name       String
  email      String   @unique
  phone      String
  payTrack   String // OWN_SUPPLIES | COMPANY_SUPPLIES
  answers    String // JSON-encoded array of choice indices (SQLite has no native array type)
  quizScore  Int
  quizPassed Boolean
  status     String   @default("PENDING") // PENDING | HIRED | REJECTED
  createdAt  DateTime @default(now())
}

model QuizQuestion {
  id           String @id @default(cuid())
  text         String
  choices      String // JSON-encoded array of choice strings
  correctIndex Int
  category     String // GENERAL | SCENARIO
  order        Int
}

model Review {
  id        String   @id @default(cuid())
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id])
  cleanerId String
  cleaner   User     @relation(fields: [cleanerId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
}

model DisciplineNote {
  id         String   @id @default(cuid())
  cleanerId  String
  cleaner    User     @relation("DisciplineSubject", fields: [cleanerId], references: [id])
  issuedById String
  issuedBy   User     @relation("DisciplineIssuer", fields: [issuedById], references: [id])
  note       String
  createdAt  DateTime @default(now())
}
