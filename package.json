{
  "name": "lavender-house-cleaning-api",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "prisma:generate": "prisma generate",
    "db:migrate:local": "wrangler d1 execute lavender-house-cleaning-db --local --file=prisma/migrations.sql",
    "db:migrate:remote": "wrangler d1 execute lavender-house-cleaning-db --remote --file=prisma/migrations.sql",
    "seed:staff:local": "wrangler d1 execute lavender-house-cleaning-db --local --file=prisma/seed-staff.sql",
    "seed:quiz:local": "node prisma/seed-quiz.js --local",
    "seed:quiz:remote": "node prisma/seed-quiz.js --remote"
  },
  "dependencies": {
    "@prisma/adapter-d1": "^6.19.3",
    "@prisma/client": "^6.3.1",
    "bcryptjs": "^2.4.3",
    "hono": "^4.13.5",
    "jose": "^6.2.10"
  },
  "devDependencies": {
    "prisma": "^6.3.1",
    "wrangler": "^4.127.0"
  }
}
